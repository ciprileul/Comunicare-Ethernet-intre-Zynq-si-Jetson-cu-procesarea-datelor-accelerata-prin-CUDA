# Fisierele de cod raman cu terminatii de linie Unix (LF), ca sa compileze identic
# pe Windows/WSL2 si pe Jetson (make nu suporta bine CRLF in Makefile).
Makefile    text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.cu        text eol=lf
*.md        text eol=lf
*.bmp       binary
*.BMP       binary
